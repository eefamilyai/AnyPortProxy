<Project>
  <PropertyGroup>
    <Version>1.5.1</Version>
    <Product>AnyPortProxy</Product>
    <Company>AnyPortProxy</Company>
    <Copyright>AnyPortProxy</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <!-- build.ps1 passes -p:UpdateRepo=owner/repo (read from the local git remote) so the app knows where updates come from. -->
  <ItemGroup Condition="'$(UpdateRepo)' != ''">
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>
</Project>
